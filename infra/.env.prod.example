# Production environment template — copy to `.env.prod` next to docker-compose.prod.yml
# Ne JAMAIS committer le fichier rempli. Ajoute-le à .gitignore.

# --- Domaines (DNS doit pointer vers le VPS Contabo avant de démarrer) -------
# Déploiement sous le sous-domaine principal gathe-finance.horus-lab.com.
# Crée 5 enregistrements DNS A/CNAME pointant vers l'IP du VPS :
#   gathe-finance.horus-lab.com           → vitrine (site)
#   portail.gathe-finance.horus-lab.com   → espace membre (portal)
#   admin.gathe-finance.horus-lab.com     → back-office (admin)
#   api.gathe-finance.horus-lab.com       → API Django / webhooks Tara
#   cms.gathe-finance.horus-lab.com       → Wagtail admin (CMS)
SITE_DOMAIN=gathe-finance.horus-lab.com
PORTAL_DOMAIN=portail.gathe-finance.horus-lab.com
ADMIN_DOMAIN=admin.gathe-finance.horus-lab.com
API_DOMAIN=api.gathe-finance.horus-lab.com
CMS_DOMAIN=cms.gathe-finance.horus-lab.com

# Django ALLOWED_HOSTS (liste séparée par virgules ; doit inclure tous les domaines + l'IP du VPS)
DJANGO_ALLOWED_HOSTS=gathe-finance.horus-lab.com,portail.gathe-finance.horus-lab.com,admin.gathe-finance.horus-lab.com,api.gathe-finance.horus-lab.com,cms.gathe-finance.horus-lab.com

# CSRF_TRUSTED_ORIGINS — obligatoire pour que les SPA admin/portail puissent
# POSTer / PATCHer le backend depuis un sous-domaine different. Si vide,
# prod.py auto-derive depuis ALLOWED_HOSTS (https://<host> pour chaque hote
# public). Surcharger ici si besoin d'origines supplementaires (ex. LAN).
CSRF_TRUSTED_ORIGINS=https://gathe-finance.horus-lab.com,https://portail.gathe-finance.horus-lab.com,https://admin.gathe-finance.horus-lab.com,https://api.gathe-finance.horus-lab.com,https://cms.gathe-finance.horus-lab.com

# --- Secrets Django ----------------------------------------------------------
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=__CHANGE_ME__
# Cron de revalidation Next.js
REVALIDATE_SECRET=__CHANGE_ME__

# Superuser de bootstrap (créé au 1er démarrage)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@gathe-finance.com
DJANGO_SUPERUSER_PASSWORD=__CHANGE_ME__

# --- Base Postgres -----------------------------------------------------------
POSTGRES_DB=gathe_prod
POSTGRES_USER=gathe
POSTGRES_PASSWORD=__CHANGE_ME__

# --- Email transactionnel (Brevo via API HTTP — django-anymail) --------------
# prod.py utilise par défaut le backend Anymail-Brevo (API HTTP, pas de SMTP).
# Colle ta CLÉ API Brevo (v3, Settings → SMTP & API → API Keys) :
BREVO_API_KEY=__YOUR_BREVO_API_KEY__
# Expéditeur : DOIT être un expéditeur/domaine VÉRIFIÉ dans Brevo, sinon rejet.
DEFAULT_FROM_EMAIL="Gathé Finance <noreply@horus-lab.com>"
# Boîte qui reçoit les messages de contact / demandes d'adhésion :
CONTACT_NOTIFICATION_EMAIL=contact@gathe-finance.com
# Test à blanc (afficher dans les logs au lieu d'envoyer) :
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Prestataire de paiement --------------------------------------------------
# Prestataire par défaut des NOUVEAUX paiements sortants (versements, payouts
# crédit, retraits épargne). Doit correspondre au `code` d'un provider
# enregistré (aujourd'hui : "tara"). Changer de prestataire = brancher son
# adaptateur (1 fichier + 1 ligne dans apps_coop/payments/providers) puis poser
# ce code ici. Un code inconnu ne bloque pas les paiements : repli sur "tara"
# avec un warning. Le webhook entrant reste routé par prestataire.
DEFAULT_PAYMENT_PROVIDER=tara

# --- Tara Money (paiements MoMo : versements + payouts) ----------------------
# IMPORTANT : si TARA_API_KEY **ou** TARA_BUSINESS_ID est vide, le provider
# tourne en MODE MOCK — aucun appel réseau, aucun STK Push, aucun payout réel.
# C'est la cause typique de « ça marche pour certains comptes et pas d'autres »
# quand une clé est posée à moitié : renseigner les DEUX en prod.
TARA_API_KEY=
TARA_BUSINESS_ID=
# TARA_WEBHOOK_SECRET : réservé (Tara ne signe pas encore le webhook). La
# défense repose sur l'URL HTTPS secrète + le contrôle du businessId côté
# backend. Renseigner si Tara active un jour la signature HMAC.
TARA_WEBHOOK_SECRET=

# PUBLIC_BASE_URL — URL publique HTTPS de l'API. OBLIGATOIRE en prod : elle
# construit le `webHookUrl` envoyé à Tara à l'init du paiement. Si elle reste
# sur le défaut localhost, Tara ne peut PAS rappeler le backend → paiements et
# payouts bloqués en « en_attente » indéfiniment.
PUBLIC_BASE_URL=https://api.gathe-finance.horus-lab.com

# COOKIE_DOMAIN — partage session/CSRF entre les sous-domaines (api / portail /
# admin / vitrine). Défaut prod.py = .gathe-finance.horus-lab.com.
COOKIE_DOMAIN=.gathe-finance.horus-lab.com

# CORS_ALLOWED_ORIGINS — origines autorisées pour les fetch credentialed des
# SPA. Si vide, prod.py l'auto-dérive depuis ALLOWED_HOSTS (comme
# CSRF_TRUSTED_ORIGINS). Sans l'origine du portail ici NI en auto-dérivation,
# le navigateur jette le Set-Cookie de /auth/csrf/ → « Session de sécurité
# expirée » à chaque versement. Laisser vide pour l'auto-dérivation, ou
# surcharger pour des origines supplémentaires.
CORS_ALLOWED_ORIGINS=

# --- Backblaze B2 (media uploads) — optionnel ; sinon stockage local ----------
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
# Si on sert le media via Cloudflare devant B2
MEDIA_DOMAIN=media.gathe-finance.com

# --- Sentry (monitoring) — optionnel -----------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Traefik / Let's Encrypt -------------------------------------------------
ACME_EMAIL=ops@gathe-finance.com

# --- Reverse-proxy nginx EXTERNE (ton nginx conteneurisé) --------------------
# Utilisé seulement avec docker-compose.nginx-external.yml : nom du réseau
# Docker sur lequel tourne déjà TON conteneur nginx. Les services Gathé y sont
# rattachés (alias gathe-site/portal/admin/backend). Trouve-le via :
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' <ton_nginx>
PROXY_NETWORK=proxy

# --- Backups -----------------------------------------------------------------
BACKUP_RETENTION_DAYS=30

# --- Tag d'images GHCR à tirer -----------------------------------------------
# Les images sont publiées par .github/workflows/release.yml sur ghcr.io.
# Tags disponibles :
#   latest      → dernière build de main (défaut)
#   main        → identique à latest
#   sha-XXXXXXX → commit précis (rollback : pin un SHA antérieur)
GATHE_IMAGE_TAG=latest
