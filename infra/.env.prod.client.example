# Template PRODUCTION CLIENTE — VPS Contabo, architecture DMZ durcie
# (Traefik v3.3 + Postgres/MinIO existants, réseaux edge/data).
# Copier en `infra/.env.prod` SUR LE SERVEUR et remplir les __CHANGE_ME__.
# NE JAMAIS committer le fichier rempli (secrets). Voir infra/DEPLOY_ENVIRONMENTS.md.

# --- Domaines (DNS A → IP du serveur, AVANT le 1er démarrage) -----------------
#   app.<racine>        → vitrine (site)
#   portail.<racine>    → espace membre (portal)
#   admin.<racine>      → back-office (admin)
#   api.<racine>        → API Django / webhooks Tara
#   cms.<racine>        → Wagtail admin (CMS)
SITE_DOMAIN=app.__CLIENT_DOMAIN__
PORTAL_DOMAIN=portail.__CLIENT_DOMAIN__
ADMIN_DOMAIN=admin.__CLIENT_DOMAIN__
API_DOMAIN=api.__CLIENT_DOMAIN__
CMS_DOMAIN=cms.__CLIENT_DOMAIN__

DJANGO_ALLOWED_HOSTS=app.__CLIENT_DOMAIN__,portail.__CLIENT_DOMAIN__,admin.__CLIENT_DOMAIN__,api.__CLIENT_DOMAIN__,cms.__CLIENT_DOMAIN__
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
COOKIE_DOMAIN=.__CLIENT_DOMAIN__

# =============================================================================
# RATTACHEMENT À LA DMZ EXISTANTE (ne lance NI notre Traefik, NI notre Postgres)
# =============================================================================
# Noms EXACTS des réseaux Docker existants (relevés via `docker network ls`) :
#   EDGE_NETWORK = réseau du Traefik v3.3 (ingress + TLS)     ex. edge / edge_edge
#   DATA_NETWORK = réseau des bases (Postgres/MinIO, isolé)   ex. data / services_data
EDGE_NETWORK=__CHANGE_ME__
DATA_NETWORK=__CHANGE_ME__
# Nom du certresolver de LEUR Traefik (voir /srv/edge ou `docker inspect traefik`).
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Base : on RÉUTILISE leur Postgres (créer base `gathe_prod` + user `gathe`) -
#   host = alias/nom du conteneur Postgres joignable sur DATA_NETWORK.
DATABASE_URL=postgres://gathe:__CHANGE_ME__@__PG_HOST__:5432/gathe_prod

# --- Médias : on RÉUTILISE leur MinIO (créer un bucket + access/secret keys) ---
AWS_STORAGE_BUCKET_NAME=gathe-media
AWS_ACCESS_KEY_ID=__CHANGE_ME__
AWS_SECRET_ACCESS_KEY=__CHANGE_ME__
# Endpoint MinIO joignable par le backend (interne DATA_NETWORK recommandé,
# sinon l'URL publique https://s3.<racine>). Région quelconque pour MinIO.
AWS_S3_ENDPOINT_URL=__CHANGE_ME__
AWS_S3_REGION_NAME=us-east-1
MEDIA_DOMAIN=

# --- Secrets Django (générer : python -c "import secrets;print(secrets.token_urlsafe(64))") ---
DJANGO_SECRET_KEY=__CHANGE_ME__
REVALIDATE_SECRET=__CHANGE_ME__
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@__CLIENT_DOMAIN__
DJANGO_SUPERUSER_PASSWORD=__CHANGE_ME__

# --- Postgres (ces 3 lignes ne servent QUE si on relançait notre propre `db`, ce
#     qu'on NE fait PAS ici. Laissées pour éviter les warnings d'interpolation). --
POSTGRES_DB=gathe_prod
POSTGRES_USER=gathe
POSTGRES_PASSWORD=unused

# --- Email Brevo (API HTTP) --------------------------------------------------
BREVO_API_KEY=__CHANGE_ME__
DEFAULT_FROM_EMAIL="Gathé Finance <noreply@__CLIENT_DOMAIN__>"
CONTACT_NOTIFICATION_EMAIL=contact@__CLIENT_DOMAIN__

# --- Paiement Tara (vides = MODE MOCK, aucun paiement réel) ------------------
DEFAULT_PAYMENT_PROVIDER=tara
TARA_API_KEY=
TARA_BUSINESS_ID=
TARA_WEBHOOK_SECRET=

# OBLIGATOIRE : URL publique HTTPS de l'API (webhook Tara).
PUBLIC_BASE_URL=https://api.__CLIENT_DOMAIN__

# --- Image GHCR à tirer : la branche cliente = main --------------------------
GATHE_IMAGE_TAG=main
