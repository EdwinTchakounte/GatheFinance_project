# Copy to ".env" at the repo root to override the docker-compose defaults.
# (Compose auto-loads a file named ".env" in the same directory as docker-compose.yml.)

# --- Host ports (change if 3000 / 8000 are already taken on your machine) ---
# If you change these, also update the *_BASE_URL / *_ORIGINS below to match.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000

# --- Database ---
POSTGRES_DB=gathe_site
POSTGRES_USER=gathe
POSTGRES_PASSWORD=gathe

# --- Backend (Django / Wagtail) ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
WAGTAILADMIN_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Shared secret for the ISR revalidation webhook (must match on both services).
REVALIDATE_SECRET=change-me

# Auto-created admin account on first boot (Wagtail/Django admin).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=adminadmin
DJANGO_SUPERUSER_EMAIL=admin@gathe-finance.com

# --- Frontend (Next.js) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
